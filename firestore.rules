rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Solo el administrador del portafolio puede escribir.
    // Reemplaza REEMPLAZAR_CON_TU_UID por tu UID:
    // Firebase Console → Authentication → Users → columna "User UID".
    // Mientras quede el texto de ejemplo, nadie puede escribir (falla cerrado).
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'REEMPLAZAR_CON_TU_UID';
    }

    // Información personal
    match /personal_info/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Habilidades
    match /skills/{skill} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Certificaciones
    match /certifications/{certification} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Redes sociales
    match /social_media/{social} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Proyectos
    match /projects/{project} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Regla por defecto: denegar todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
